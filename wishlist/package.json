{
  "name": "smart-wishlist",
  "version": "1.0.0",
  "private": true,
  "description": "Paste a product link; get photo, price, sizes, colors and a category automatically.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "build:web": "esbuild web/browser-extract.js --bundle --format=esm --minify --target=es2020 --platform=browser --alias:cheerio=cheerio/slim --outfile=public/extract.bundle.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
